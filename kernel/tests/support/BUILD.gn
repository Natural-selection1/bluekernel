import("//build/templates/build_template.gni")

build_rust("dynamic_test_support") {
  testonly = true
  crate_name = "blueos_dynamic_test_support"
  crate_type = "rlib"
  edition = "2021"
  sources = [ "src/lib.rs" ]
  deps = [
    "//external/vendor/semihosting-0.1.20:semihosting",
    "//kernel/kernel:blueos",
    "//kernel/loader:blueos_loader",
  ]
}

run_clippy("dynamic_test_support_clippy") {
  testonly = true
  deps = [ ":dynamic_test_support" ]
}
